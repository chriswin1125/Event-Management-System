# Server Port
PORT=5000

# Node Environment ('development' or 'production')
NODE_ENV=development

# Database Connection URI
# Local MongoDB:
MONGO_URI=mongodb://127.0.0.1:27017/event_management_db

# MongoDB Atlas (Cloud Deployment):
# Replace <username>, <password>, and <cluster-url> with your MongoDB Atlas cluster credentials
# MONGO_URI=mongodb+srv://<username>:<password>@<cluster-url>.mongodb.net/event_management_db?retryWrites=true&w=majority&appName=EventHub

# JWT Secret Key for Authentication
JWT_SECRET=super_secret_apple_grade_event_management_jwt_key_2026

# Allowed Frontend Client URL (comma-separated for multiple origins, e.g. http://localhost:5173,https://your-app.vercel.app)
CLIENT_URL=http://localhost:5173

# Razorpay Test Credentials
RAZORPAY_KEY_ID=rzp_test_sampleKey123
RAZORPAY_KEY_SECRET=sampleSecretKey123

# Email Notifications (optional - automatically uses Ethereal test account if left blank)
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
